  "rules": [
    "% the application can be made only from 4 May 2026 to 4 March 2027",
    "verdict(too_early) :- applied_on(S, D), date_early(D).",
    "verdict(too_late) :- applied_on(S, D), date_late(D).",
    "% PESEL UKR must be active on the day of the application (adult and child alike)",
    "verdict(no_pesel_today) :- pesel_today_inactive(S).",
    "% the MOS system blocks the application when the registers lack data",
    "verdict(registers_incomplete) :- registers_lacking(S).",
    "% conditions of the first group only: PESEL UKR on 4 June 2025 and at least 365 days of UKR status",
    "verdict(no_pesel_june_2025) :- came_after_war(A), pesel_june_2025_inactive(S).",
    "verdict(under_365_days) :- came_after_war(A), status_days(S, N), days_short(N).",
    "% condition of a child born in Poland: the mother holds a CUKR card",
    "verdict(mother_without_card) :- child_born_in_poland(C), mother_has_no_card(S).",
    "% eligible: every condition of the applicant's group is met",
    "can_apply(S) :- applied_on(S, D), date_in_window(D), registers_complete(R), pesel_today_active(P).",
    "verdict(eligible) :- can_apply(S), came_after_war(A), pesel_june_2025_active(J), status_days(T, N), days_enough(N).",
    "verdict(eligible) :- can_apply(S), child_born_in_poland(C), mother_has_card(M)."
  ],
