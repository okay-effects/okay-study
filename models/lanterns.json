  "rules": [
    "% drop the sentence number",
    "iskindled(X) :- kindled(N, X).",
    "isveiled(X) :- veiled(N, X).",
    "edge(X, Y) :- tends(N, X, Y).",
    "% a kindled Thing is warm",
    "warm(X) :- iskindled(X).",
    "% a Thing passes warmth on if it is kindled, or warm and not veiled",
    "passes(X) :- iskindled(X).",
    "passes(X) :- warm(X), not isveiled(X).",
    "% warmth travels along tending",
    "warm(Y) :- passes(X), edge(X, Y).",
    "% a Thing that is not warm is dark",
    "dark(X) :- thing(X), not warm(X).",
    "% a warm Thing tending a dark one makes a rift",
    "rift(X, Y) :- warm(X), edge(X, Y), dark(Y)."
  ],
  "answers": [
